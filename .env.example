# LinkedIn Post Agent — email only

# LLM for post text
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_PROVIDER=openai

# Images: openai (photorealistic) | auto | local (Pillow only)
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1024x1792
OPENAI_IMAGE_QUALITY=hd
IMAGE_POLLINATIONS=0

# Email (Gmail App Password)
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
