# Copy to .env and fill in values

# OpenAI for AI-written posts + DALL-E images
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1792x1024
OPENAI_IMAGE_QUALITY=standard

# Optional: Anthropic Claude as alternative for post text
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Use openai | anthropic | none (post text)
AI_PROVIDER=openai

# Image: auto (OpenAI → curated stock) | openai | stock | local | none
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=high
IMAGE_PROVIDER=auto
# Set to 1 only if you want experimental free AI images (often lower quality)
IMAGE_POLLINATIONS=0

# Email (Gmail: use an App Password)
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=momin.shiraj440@gmail.com
